# Copy to .env.local (never commit real values). Without DATABASE_URL the site builds from seed/content.json.
# Postgres: Neon pooled connection string in production; a local database in development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clearup
# Signs the admin login cookie. 64 random hex characters: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Image uploads (Cloudinary → Settings → API Keys). Leave empty to store uploads in the database.
CLOUDINARY_URL=
# Only for `npm run db:seed` (creates / resets the admin login). Remove from .env.local afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The public address of the site (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://clearup-agency.vercel.app
# Set to true ONLY on the official domain at launch (lets Google index the site).
SEO_INDEXABLE=
